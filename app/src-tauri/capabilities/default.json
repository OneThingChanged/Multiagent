{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "notification:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-request-user-attention",
    "updater:default",
    "process:default"
  ]
}
