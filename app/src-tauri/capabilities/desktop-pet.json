{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-pet",
  "description": "Permissions for the non-focusable always-on-top desktop pet window.",
  "windows": ["desktop-pet"],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging"
