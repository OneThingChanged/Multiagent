{
  "name": "app",
  "description": "Acedia desktop terminal workspace",
  "author": "Acedia",
  "private": true,
  "version": "1.8.0",
  "multiAgentReleaseVersion": "1.8.0.0",
  "multiAgentVariant": "standard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:smoke": "electron electron/pty-smoke.mjs",
    "electron:bridge-smoke": "node scripts/electron-bridge-smoke.mjs",
    "electron:browser-form-smoke": "electron scripts/electron-browser-form-smoke.mjs",
    "electron:lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs",
    "electron:single-instance-smoke": "node scripts/electron-single-instance-smoke.mjs",
    "electron:packaged-lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs --packaged",
    "electron:packaged-smoke": "node scripts/electron-packaged-smoke.mjs",
    "electron:company-packaged-smoke": "node scripts/electron-packaged-smoke.mjs --company",
    "electron:company-packaged-lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs --packaged --company",
    "electron:store-packaged-smoke": "node scripts/electron-packaged-smoke.mjs --store",
    "electron:store-packaged-lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs --packaged --store",
    "electron:pack": "node scripts/build-electron-standard.mjs --dir",
    "electron:dist": "node scripts/build-electron-standard.mjs",
    "electron:dist:company": "node scripts/build-electron-company.mjs",
    "electron:dist:store:dev": "node scripts/build-electron-store.mjs --dev",
    "electron:dist:store": "node scripts/build-electron-store.mjs",
    "electron:verify:store:dev": "node scripts/verify-electron-store-msix.mjs --dev",
    "electron:verify:store": "node scripts/verify-electron-store-msix.mjs",
    "electron:install:store:dev": "pwsh -NoLogo -NoProfile -File scripts/install-electron-store-dev.ps1",
    "electron:wack:store:dev": "pwsh -NoLogo -NoProfile -File scripts/test-electron-store-wack.ps1",
    "electron:dist:all": "node scripts/build-electron-all.mjs",
    "release:build:github": "node scripts/build-electron-standard.mjs",
    "release:build:store": "node scripts/build-electron-store.mjs",
    "release:verify:store": "node scripts/verify-electron-store-msix.mjs",
    "release:build:all": "node scripts/build-electron-all.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.6"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.jintae.multiagent.electron",
    "productName": "Acedia",
    "executableName": "Acedia",
    "extraMetadata": {
      "multiAgentVariant": "standard"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "electron/services/browser-mcp-server.mjs"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "!electron/remote-pwa/downloads/**",
      "package.json",
      "assets/icon.ico",
      "node_modules/node-pty/**",
      "node_modules/@xterm/xterm/**",
      "node_modules/web-push/**"
    ],
    "directories": {
      "output": "electron-dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Acedia-Setup-1.8.0.0-${arch}.${ext}",
      "shortcutName": "Acedia",
      "uninstallDisplayName": "Acedia 1.8.0.0",
      "include": "electron/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OneThingChanged",
        "repo": "Multiagent",
        "channel": "latest"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  }
}
