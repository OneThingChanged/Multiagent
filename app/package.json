{
  "name": "app",
  "description": "MultiAgent desktop terminal workspace",
  "author": "MultiAgent",
  "private": true,
  "version": "0.5.98",
  "multiAgentVariant": "standard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:smoke": "electron electron/pty-smoke.mjs",
    "electron:bridge-smoke": "node scripts/electron-bridge-smoke.mjs",
    "electron:lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs",
    "electron:single-instance-smoke": "node scripts/electron-single-instance-smoke.mjs",
    "electron:packaged-lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs --packaged",
    "electron:packaged-smoke": "node scripts/electron-packaged-smoke.mjs",
    "electron:company-packaged-smoke": "node scripts/electron-packaged-smoke.mjs --company",
    "electron:company-packaged-lifecycle-smoke": "node scripts/electron-lifecycle-smoke.mjs --packaged --company",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "electron:dist:company": "node scripts/build-electron-company.mjs",
    "electron:dist:all": "node scripts/build-electron-all.mjs",
    "tauri": "tauri",
    "tauri:build:standard": "node scripts/build-variant.mjs standard",
    "tauri:build:company": "node scripts/build-variant.mjs company",
    "tauri:build:all": "node scripts/build-all-variants.mjs",
    "release:build:all": "node scripts/build-all-variants.mjs --require-signed",
    "release:manifests": "node scripts/write-latest-json.mjs",
    "release:electron-transition-manifest": "node scripts/write-electron-transition-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.6"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.jintae.multiagent.electron",
    "productName": "MultiAgent",
    "executableName": "MultiAgent",
    "extraMetadata": {
      "multiAgentVariant": "standard"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "electron/remote-pwa/downloads/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "src-tauri/icons/icon.ico",
      "node_modules/node-pty/**",
      "node_modules/@xterm/xterm/**",
      "node_modules/web-push/**"
    ],
    "directories": {
      "output": "electron-dist"
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "MultiAgent-Setup-${version}-${arch}.${ext}",
      "shortcutName": "MultiAgent",
      "uninstallDisplayName": "MultiAgent ${version}",
      "include": "electron/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OneThingChanged",
        "repo": "Multiagent",
        "channel": "latest"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  }
}
