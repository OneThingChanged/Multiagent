{
  "name": "multiagent-mobile",
  "description": "Native Android client for the MultiAgent Remote service.",
  "private": true,
  "version": "0.3.2",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 4430",
    "android": "expo start --android --port 4430",
    "ios": "expo start --ios --port 4430",
    "web": "expo start --web --port 4430",
    "test": "node --test tests/remoteUrl.test.mjs tests/notificationBridge.test.mjs tests/profiles.test.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "signing:setup": "node scripts/setup-signing.mjs",
    "apk": "node scripts/build-apk.mjs",
    "apk:verify": "node scripts/build-apk.mjs --allow-debug-signing"
  }
}
