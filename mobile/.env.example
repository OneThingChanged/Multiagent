# Public Expo/EAS project identifier. Obtain it from your own Expo project.
MULTIAGENT_EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Absolute path to a local Firebase Android config file. Never commit that file.
MULTIAGENT_GOOGLE_SERVICES_JSON=C:\\secure\\multiagent\\google-services.json

# Release signing values stay on the build machine. Never commit the keystore or passwords.
MULTIAGENT_ANDROID_KEYSTORE_PATH=C:\\secure\\multiagent\\multiagent-release.keystore
MULTIAGENT_ANDROID_KEYSTORE_PASSWORD=replace-locally
MULTIAGENT_ANDROID_KEY_ALIAS=multiagent
MULTIAGENT_ANDROID_KEY_PASSWORD=replace-locally
